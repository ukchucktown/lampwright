{
  "name": "skill-cleaner",
  "version": "0.1.0",
  "description": "Discover and safely remove AI agent skills.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "skill-cleaner": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./adapter-v1.schema.json": "./schemas/adapter-v1.schema.json",
    "./cli-v1.schema.json": "./schemas/cli-v1.schema.json"
  },
  "files": [
    "CONTEXT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "dist",
    "docs",
    "schemas"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"schemas/**/*.json\" \".github/**/*.yml\" \"*.{json,js}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"schemas/**/*.json\" \".github/**/*.yml\" \"*.{json,js}\"",
    "lint": "eslint . --max-warnings 0",
    "pack:check": "npm run build && node scripts/verify-package.mjs",
    "prepack": "npm run build",
    "release:candidate": "npm run pack:check && node scripts/create-release-candidate.mjs",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukchucktown/skill-cleaner.git"
  },
  "bugs": {
    "url": "https://github.com/ukchucktown/skill-cleaner/issues"
  },
  "homepage": "https://github.com/ukchucktown/skill-cleaner#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
