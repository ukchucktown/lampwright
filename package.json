{
  "name": "skill-cleaner",
  "version": "0.1.0",
  "description": "Discover and safely remove AI agent skills.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "skill-cleaner": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \".github/**/*.yml\" \"*.{json,js}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \".github/**/*.yml\" \"*.{json,js}\"",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukchucktown/skill-cleaner.git"
  },
  "bugs": {
    "url": "https://github.com/ukchucktown/skill-cleaner/issues"
  },
  "homepage": "https://github.com/ukchucktown/skill-cleaner#readme",
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
