            "command": { "$ref": "#/$defs/commandVariant" },
            "successExitCodes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          }
        }
      ]
    }
  }
}
